// ============================================================================
// CLIMATE RESILIENCE OF HIMALAYAN TOURISM - DAX MEASURES
// Author: Sneha Chaudhary
//
// Built for the cleaned tables produced by src/data_preprocessing.py and src/analysis.py:
//   Tourism     <- data/processed/tourism_district_year.csv   (District, Year, Indian, Foreign, Total, ...)
//   Rainfall    <- data/processed/rainfall_district_year.csv  (District, Year, Annual_Rainfall_mm, ...)
//   Landslides  <- data/processed/landslides_by_year.csv      (Year, Landslides, Type, Comparable_Event_Count)
//   Resilience  <- data/processed/district_resilience.csv     (District, Resilience_Index, ...)
//   District    dimension: DISTINCT(Tourism[District])
//   Year        dimension: GENERATESERIES(2000, 2024, 1)
// Relationships (single direction, 1:*): District -> Tourism, Rainfall, Resilience;
//                                         Year -> Tourism, Rainfall, Landslides
// ============================================================================


// ----------------------------------------------------------------------------
// 1. TOURISM KPIs
// ----------------------------------------------------------------------------

Total Visitors =
SUM ( Tourism[Total] )

Domestic Visitors =
SUM ( Tourism[Indian] )

Foreign Visitors =
SUM ( Tourism[Foreign] )

Foreign Share % =
DIVIDE ( [Foreign Visitors], [Total Visitors] )

// Year-over-year change using the integer Year dimension (no date table needed for annual data)
Visitors Previous Year =
VAR CurrentYear = SELECTEDVALUE ( 'Year'[Year] )
RETURN
    CALCULATE ( [Total Visitors], 'Year'[Year] = CurrentYear - 1 )

YoY Visitor Change % =
DIVIDE ( [Total Visitors] - [Visitors Previous Year], [Visitors Previous Year] )


// ----------------------------------------------------------------------------
// 2. RAINFALL
// Annual_Rainfall_mm = mean daily rainfall x days in year. Do NOT use the raw
// Total_Rainfall_mm column: it is summed over grid cells, so it grows with district area.
// ----------------------------------------------------------------------------

Avg Annual Rainfall (mm) =
AVERAGE ( Rainfall[Annual_Rainfall_mm] )

Rainfall Anomaly % =
AVERAGE ( Rainfall[Rainfall_Anomaly_pct] ) / 100


// ----------------------------------------------------------------------------
// 3. LANDSLIDES
// Rows come from different counting methods; only event-based counts are comparable.
// ----------------------------------------------------------------------------

Landslides (Event-based) =
CALCULATE ( SUM ( Landslides[Landslides] ), Landslides[Comparable_Event_Count] = TRUE () )


// ----------------------------------------------------------------------------
// 4. SHOCK & RESILIENCE
// ----------------------------------------------------------------------------

// Visitors in the selected year as % of a fixed pre-shock baseline (2012 for Kedarnath 2013)
Visitors vs 2012 Baseline =
VAR Baseline =
    CALCULATE ( [Total Visitors], REMOVEFILTERS ( 'Year' ), 'Year'[Year] = 2012 )
RETURN
    DIVIDE ( [Total Visitors], Baseline )

Visitors vs 2019 Baseline =
VAR Baseline =
    CALCULATE ( [Total Visitors], REMOVEFILTERS ( 'Year' ), 'Year'[Year] = 2019 )
RETURN
    DIVIDE ( [Total Visitors], Baseline )

// Composite index computed in Python (equal-weighted, min-max scaled components); averaging
// across districts is only meaningful for a selection, so show it per district.
Resilience Index =
AVERAGE ( Resilience[Resilience_Index] )

Resilience Band =
VAR Score = [Resilience Index]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( Score ), BLANK (),
        Score >= 70, "High resilience",
        Score >= 40, "Medium resilience",
        "Low resilience"
    )
